<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds DeviceHaven-Server.msi from the published server (dotnet publish ... -o out\server). -->
  <PropertyGroup>
    <OutputName>DeviceHaven-Server</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ServerPublishDir Condition="'$(ServerPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\out\server</ServerPublishDir>
    <!-- ICE38/ICE43 assume Start menu shortcuts are per-user; this package is per-machine (all users). -->
    <SuppressIces>ICE38;ICE43</SuppressIces>
    <DefineConstants>ProductVersion=$(Version);ServerDir=$(ServerPublishDir);AssetsDir=$(AssetsDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Firewall.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
